@page
@model LoginModel

@{
    ViewData["Title"] = "Giriş Yap";
}
<link href="~/css/login.css" rel="stylesheet" />
<div class="login-kanban-bg d-flex align-items-center justify-content-center">
    <div class="login-kanban-card shadow-lg p-4 p-md-5">
        <div class="text-center mb-4">
            <i class="bi bi-lock-fill" style="font-size: 2.7rem; color: #5fbcff;"></i>
            <h2 class="fw-bold mb-2 mt-2" style="color: #215067;">Giriş Yap</h2>
            <div class="small text-muted mb-2">Planlarınızı yönetmek için hesabınıza giriş yapın.</div>
        </div>
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-2" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="E-posta" />
                <label asp-for="Input.Email">E-posta</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Şifre" />
                <label asp-for="Input.Password">Şifre</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3 text-start">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">
                    Beni Hatırla
                </label>
            </div>
            <button id="login-submit" type="submit" class="w-100 btn login-main-btn mb-2">Giriş Yap</button>
            <div class="d-flex justify-content-between">
                <a id="forgot-password" asp-page="./ForgotPassword" class="small">Şifremi Unuttum?</a>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="small">Hesap Oluştur</a>
            </div>
            <div class="text-center mt-3">
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="small">Doğrulama e-postasını tekrar gönder</a>
            </div>
        </form>
        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <hr class="my-4"/>
            <div class="text-center mb-2 text-muted">veya sosyal hesap ile giriş yap</div>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="btn btn-outline-primary w-100 mb-2" name="provider" value="@provider.Name">
                        <i class="bi bi-box-arrow-in-right me-2"></i> @provider.DisplayName ile giriş yap
                    </button>
                }
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
