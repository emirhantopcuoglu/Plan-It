@page
@model LoginModel
@{
    ViewData["Title"] = "Giriş Yap";
}
<link href="~/css/auth.css" rel="stylesheet" asp-append-version="true" />

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-head">
            <div class="auth-icon"><i class="bi bi-box-arrow-in-right"></i></div>
            <h1>Tekrar hoşgeldin</h1>
            <p class="auth-sub">Planlarına erişmek için giriş yap.</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2 small" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="E-posta" />
                <label asp-for="Input.Email">E-posta</label>
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Şifre" />
                <label asp-for="Input.Password">Şifre</label>
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">Beni hatırla</label>
            </div>

            <button id="login-submit" type="submit" class="btn-pi btn-primary-pi">
                Giriş Yap
            </button>

            <div class="auth-meta">
                <a asp-page="./ForgotPassword">Şifremi unuttum</a>
                <a asp-page="./ResendEmailConfirmation">Doğrulama e-postası</a>
            </div>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="auth-divider">veya</div>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="btn-pi btn-secondary-pi w-100 mb-2"
                            name="provider" value="@provider.Name">
                        <i class="bi bi-box-arrow-in-right"></i>@provider.DisplayName
                    </button>
                }
            </form>
        }

        <div class="auth-foot">
            Hesabın yok mu?
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Hesap oluştur</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
