@page
@model RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
}
<link href="~/css/auth.css" rel="stylesheet" asp-append-version="true" />

<div class="auth-shell">
    <div class="auth-card">
        <div class="auth-head">
            <div class="auth-icon"><i class="bi bi-person-plus"></i></div>
            <h1>Hesap oluştur</h1>
            <p class="auth-sub">30 saniyede bitir, planlamaya başla.</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2 small" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="E-posta" />
                <label asp-for="Input.Email">E-posta</label>
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Şifre" />
                <label asp-for="Input.Password">Şifre</label>
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Şifre (tekrar)" />
                <label asp-for="Input.ConfirmPassword">Şifre (tekrar)</label>
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn-pi btn-primary-pi">
                Kayıt Ol
            </button>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="auth-divider">veya</div>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="btn-pi btn-secondary-pi w-100 mb-2"
                            name="provider" value="@provider.Name">
                        <i class="bi bi-box-arrow-in-right"></i>@provider.DisplayName
                    </button>
                }
            </form>
        }

        <div class="auth-foot">
            Hesabın var mı?
            <a asp-area="Identity" asp-page="/Account/Login">Giriş yap</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
