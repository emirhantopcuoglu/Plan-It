@model IEnumerable<Category>

<h2>Kategoriler</h2>
<a class="btn btn-primary" asp-action="Create">Yeni Kategori Ekle</a>

<table class="table">
    <thead>
        <tr>
            <th>Ad</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.CategoryId">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
