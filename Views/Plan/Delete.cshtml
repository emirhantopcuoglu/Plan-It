@model Plan

<div class="container vh-100 d-flex justify-content-center align-items-center">
    <div class="text-center">
        <h2 class="display-4 mb-4">Silme Onayı</h2>
        <p class="lead">Bu planı silmek istediğinizden emin misiniz?</p>

        <form method="post">
            <button type="submit" class="btn btn-danger btn-lg mb-3">
                <i class="bi bi-trash"></i> Evet, Sil
            </button>
            <br />
            <a href="@Url.Action("Index", "Plan")" class="btn btn-secondary btn-lg">
                <i class="bi bi-arrow-left"></i> Hayır, Geri Dön
            </a>
        </form>
    </div>
</div>
