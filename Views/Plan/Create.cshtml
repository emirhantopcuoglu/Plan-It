@model PlanViewModel

<h2>Yeni Plan</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Başlık</label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="form-group">
        <label>Teslim Tarihi</label>
        <input asp-for="Deadline" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label>Kategori</label>
        <select asp-for="CategoryId" class="form-control" asp-items="Model.Categories"></select>
    </div>
    <div class="form-group">
        <label for="Priority">Öncelik</label>
        <select asp-for="Priority" class="form-control" asp-items="new SelectList(ViewBag.Priorities)">
            <option value="">Seçiniz</option>
        </select>
    </div>
    <button type="submit" class="btn btn-success">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Geri</a>
</form>