@model IEnumerable<Plan>

    <div class="container mt-5">
        <h1 class="text-center mb-4">Planlarım</h1>

        @if (!Model.Any())
        {
        <p class="text-muted">Henüz bir plan eklenmedi.</p>
        }

        <table class="table table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th scope="col">Başlık</th>
                    <th scope="col">Oluşturulma Tarihi</th>
                    <th scope="col">Son Tarih</th>
                    <th scope="col">Durum</th>
                    <th scope="col">Kategori</th>
                    <th scope="col">Eylemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var plan in Model)
                {
                <tr>
                    <td>@plan.Title</td>
                    <td>@plan.CreatedDate.ToString("dd-MM-yyyy HH:mm")</td>
                    <td>@plan.Deadline.ToString("dd-MM-yyyy HH:mm")</td>

                    <td id="completion-status-@plan.PlanId">
                        @if (plan.IsCompleted)
                        {
                        <i class="bi bi-check-circle-fill text-success" style="cursor: pointer;"
                            onclick="toggleCompletion(@plan.PlanId, false)"></i>
                        }
                        else
                        {
                        <i class="bi bi-x-circle-fill text-danger" style="cursor: pointer;"
                            onclick="toggleCompletion(@plan.PlanId, true)"></i>
                        }
                    </td>
                    <td>@plan.Category.Name</td>

                    <td>
                        <a class="btn btn-warning btn-sm" href="@Url.Action("Edit", "Plan" , new { id=plan.PlanId })">
                            <i class="bi bi-pencil"></i> Düzenle
                        </a>
                        <a class="btn btn-danger btn-sm" href="@Url.Action("Delete", "Plan" , new { id=plan.PlanId })">
                            <i class="bi bi-trash"></i> Sil
                        </a>

                    </td>
                </tr>
                }
            </tbody>
        </table>

        <a class="btn btn-success" asp-controller="Plan" asp-action="Create">Yeni plan ekle</a>
    </div>

    <script>
        function toggleCompletion(planId, newStatus) {
            $.ajax({
                url: '/Plan/UpdateCompletionStatus',
                method: 'POST',
                data: { id: planId, isCompleted: newStatus },
                success: function (response) {
                    if (response.success) {
                        // Durumu güncelleyen ikonu değiştirme
                        var icon = newStatus ?
                            '<i class="bi bi-check-circle-fill text-success" style="cursor: pointer;" onclick="toggleCompletion(' + planId + ', false)"></i>' :
                            '<i class="bi bi-x-circle-fill text-danger" style="cursor: pointer;" onclick="toggleCompletion(' + planId + ', true)"></i>';
                        $('#completion-status-' + planId).html(icon);
                    }
                }
            });
        }
    </script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
