@model IEnumerable<Plan>

<h2>Planlar</h2>

<a asp-action="Create" class="btn btn-success">Yeni Plan</a>

<table class="table">
    <thead>
        <tr>
            <th>Başlık</th>
            <th>Tarih</th>
            <th>Kategori</th>
            <th>Durum</th>
            <th>Öncelik</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var plan in Model)
    {
        <tr>
            <td>@plan.Title</td>
            <td>@plan.Deadline.ToShortDateString()</td>
            <td>@plan.Category?.Name</td>
            <td>
                @{
                    var statusText = plan.Status switch
                    {
                        PlanStatus.NotStarted => "Başlamadı",
                        PlanStatus.InProgress => "Devam Ediyor",
                        PlanStatus.Completed => "Tamamlandı",
                        PlanStatus.Cancelled => "İptal Edildi",
                        _ => "Bilinmiyor"
                    };
                }
                @statusText
            </td>
            <td>@{
                    var priorityText = plan.Priority switch
                    {
                        PriorityLevel.Low => "Düşük",
                        PriorityLevel.Medium => "Orta",
                        PriorityLevel.High=> "Yüksek",
                        _ => "Bilinmiyor"
                    };
                }
                @priorityText</td>
            <td>
                <a asp-action="Edit" asp-route-id="@plan.PlanId" class="btn btn-primary">Düzenle</a>
                <form asp-action="Delete" asp-route-id="@plan.PlanId" method="post" style="display:inline;">
                    <button class="btn btn-danger" onclick="return confirm('Silinsin mi?');">Sil</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
