@model PlanViewModel

<h2>Planı Düzenle</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="PlanId" />

    <div class="form-group">
        <label>Başlık</label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="form-group">
        <label>Teslim Tarihi</label>
        <input asp-for="Deadline" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label>Kategori</label>
        <select asp-for="CategoryId" class="form-control" asp-items="Model.Categories"></select>
    </div>
    <div class="form-group">
        <label>Durum</label>
        <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<PlanStatus>()"></select>
    </div>

    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>