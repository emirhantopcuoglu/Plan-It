@model PlanViewModel

<link href="~/css/plan-forms.css" rel="stylesheet" />

<h2 class="edit-title mb-4">Planı Düzenle</h2>

<div class="edit-form-container">
    <form asp-action="Edit" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PlanId" />

        <div class="edit-form-group">
            <label asp-for="Title" class="edit-label">Başlık</label>
            <input asp-for="Title" class="form-control edit-input" placeholder="Plan başlığı giriniz..." />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="edit-form-group">
            <label asp-for="Deadline" class="edit-label">Teslim Tarihi</label>
            <input asp-for="Deadline" type="date" class="form-control edit-input" />
            <span asp-validation-for="Deadline" class="text-danger small"></span>
        </div>
        <div class="edit-form-group">
            <label asp-for="CategoryId" class="edit-label">Kategori</label>
            <select asp-for="CategoryId" class="form-control edit-input" asp-items="Model.Categories"></select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>
        <div class="edit-form-group">
            <label asp-for="Status" class="edit-label">Durum</label>
            <select asp-for="Status" class="form-control edit-input" asp-items="Html.GetEnumSelectList<PlanStatus>()"></select>
        </div>
        <div class="edit-form-group">
            <label asp-for="Priority" class="edit-label">Öncelik</label>
            <select asp-for="Priority" class="form-control edit-input" asp-items="new SelectList(ViewBag.Priorities)">
                <option value="">Seçiniz</option>
            </select>
        </div>

        <div class="edit-form-actions mt-4">
            <button type="submit" class="btn edit-btn-save">Güncelle</button>
            <a asp-action="Index" class="btn edit-btn-cancel">İptal</a>
        </div>
    </form>
</div>
