@{
    ViewData["Title"] = "Plan-It – Akıllı Plan Yönetimi";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
}
<link href="~/css/welcome.css" rel="stylesheet" />

@if (isAuthenticated)
{
    <div class="hero-section hero-compact">
        <div class="hero-text">
            <div class="hero-badge">✦ Hoşgeldiniz</div>
            <h1 class="hero-title">Planlarınız sizi bekliyor.</h1>
            <p class="hero-sub">
                Devam eden görevlerinizi takip edin, yeni planlar oluşturun ve hedeflerinize odaklanın.
            </p>
            <div class="hero-ctas" style="justify-content:center;">
                <a asp-controller="Plan" asp-action="Index" class="btn btn-hero-primary">
                    <i class="bi bi-kanban me-2"></i>Planlarıma Git
                </a>
                <a asp-controller="Plan" asp-action="Create" class="btn btn-hero-secondary">
                    <i class="bi bi-plus-circle me-2"></i>Yeni Plan Oluştur
                </a>
            </div>
        </div>
    </div>
}
else
{
    <div class="hero-section">
        <div class="hero-content">
            <div class="hero-text">
                <div class="hero-badge">✦ Ücretsiz &amp; Açık Kaynak</div>
                <h1 class="hero-title">
                    Planlarını yönet,<br />
                    <span class="hero-accent">hedeflerine ulaş.</span>
                </h1>
                <p class="hero-sub">
                    Plan-It ile görevlerini Kanban panosu üzerinden takip et,
                    öncelik sırala ve son tarihlerini asla kaçırma.
                </p>
                <div class="hero-ctas">
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-hero-primary">
                        Ücretsiz Başla
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-hero-secondary">
                        Giriş Yap
                    </a>
                </div>
            </div>

            <div class="hero-visual">
                <div class="mock-kanban">
                    <div class="mock-col mock-col-blue">
                        <div class="mock-col-header">🔄 Devam Ediyor</div>
                        <div class="mock-card">
                            <div class="mock-card-title">Proje raporu</div>
                            <span class="mock-card-badge high">Yüksek</span>
                        </div>
                        <div class="mock-card">
                            <div class="mock-card-title">Tasarım revizyonu</div>
                            <span class="mock-card-badge medium">Orta</span>
                        </div>
                    </div>
                    <div class="mock-col mock-col-green">
                        <div class="mock-col-header">✅ Tamamlandı</div>
                        <div class="mock-card">
                            <div class="mock-card-title">Sprint planlama</div>
                            <span class="mock-card-badge low">Düşük</span>
                        </div>
                        <div class="mock-card">
                            <div class="mock-card-title">API entegrasyonu</div>
                            <span class="mock-card-badge medium">Orta</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="features-section">
        <h2 class="features-title">Neden Plan-It?</h2>
        <div class="features-grid">
            <div class="feature-card">
                <span class="feature-icon">🗂️</span>
                <h3>Kanban Panosu</h3>
                <p>Görevlerini sürükle-bırak ile sütunlar arasında taşı. Durum güncellemeleri anlık kaydedilir.</p>
            </div>
            <div class="feature-card">
                <span class="feature-icon">⚡</span>
                <h3>Öncelik Sistemi</h3>
                <p>Düşük, Orta ve Yüksek öncelik seviyeleriyle en kritik işe odaklan, dikkatini dağıtma.</p>
            </div>
            <div class="feature-card">
                <span class="feature-icon">📅</span>
                <h3>Son Tarih Takibi</h3>
                <p>Her plan için teslim tarihi belirle. Deadline'larını kaçırmadan projelerini zamanında bitir.</p>
            </div>
            <div class="feature-card">
                <span class="feature-icon">🏷️</span>
                <h3>Kategori Yönetimi</h3>
                <p>Planlarını anlamlı kategorilere gruplandır. İş, kişisel, eğitim — her şey düzenli.</p>
            </div>
        </div>
    </div>
}
