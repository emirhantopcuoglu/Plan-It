@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="kb-toolbar">
    <div class="kb-heading">
        <h1>Admin Paneli</h1>
        <p>Sistem genel bakış · kullanıcı yönetimi</p>
    </div>
    <a asp-controller="Category" asp-action="Index" class="btn-pi btn-secondary-pi">
        <i class="bi bi-tags"></i>Kategorileri Yönet
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="card-pi mb-3" style="background:var(--danger-soft);border-color:var(--danger);color:#7f1d1d;">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
    </div>
}

<div class="admin-stats">
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--brand-soft);color:var(--brand);">
            <i class="bi bi-people"></i>
        </div>
        <div>
            <div class="stat-label">Toplam Kullanıcı</div>
            <div class="stat-value">@Model.TotalUsers</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:var(--info-soft);color:var(--info);">
            <i class="bi bi-clipboard-check"></i>
        </div>
        <div>
            <div class="stat-label">Toplam Plan</div>
            <div class="stat-value">@Model.TotalPlans</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:var(--success-soft);color:var(--success);">
            <i class="bi bi-check2-circle"></i>
        </div>
        <div>
            <div class="stat-label">Tamamlanan</div>
            <div class="stat-value">@Model.CompletedPlans</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:var(--warning-soft);color:var(--warning);">
            <i class="bi bi-arrow-repeat"></i>
        </div>
        <div>
            <div class="stat-label">Devam Eden</div>
            <div class="stat-value">@Model.InProgressPlans</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:var(--danger-soft);color:var(--danger);">
            <i class="bi bi-clock-history"></i>
        </div>
        <div>
            <div class="stat-label">Süresi Geçen</div>
            <div class="stat-value">@Model.OverduePlans</div>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon" style="background:var(--surface-muted);color:var(--text-secondary);">
            <i class="bi bi-tags"></i>
        </div>
        <div>
            <div class="stat-label">Kategoriler</div>
            <div class="stat-value">@Model.TotalCategories</div>
        </div>
    </div>
</div>

<div class="card-pi" style="padding:0;margin-top:24px;">
    <div style="padding:18px 22px;border-bottom:1px solid var(--border);">
        <h2 style="margin:0;font-size:1.05rem;">Kullanıcılar</h2>
        <p class="text-secondary-pi" style="margin:2px 0 0;font-size:0.85rem;">Son 20 kullanıcı</p>
    </div>
    <table class="table mb-0" style="margin:0;">
        <thead>
            <tr>
                <th style="padding:12px 22px;">E-posta</th>
                <th style="padding:12px 22px;width:1%;white-space:nowrap;">Rol</th>
                <th style="padding:12px 22px;width:1%;white-space:nowrap;text-align:center;">Plan</th>
                <th style="padding:12px 22px;width:1%;white-space:nowrap;text-align:right;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.RecentUsers)
            {
                <tr>
                    <td style="padding:12px 22px;">
                        <span class="user-avatar" style="display:inline-flex;margin-right:8px;vertical-align:middle;">
                            @(user.Email.Length > 0 ? user.Email[..1].ToUpper() : "?")
                        </span>
                        @user.Email
                    </td>
                    <td style="padding:12px 22px;">
                        @if (user.IsAdmin)
                        {
                            <span class="badge-pi" style="background:var(--brand-soft);color:var(--brand-text);">
                                <i class="bi bi-shield-lock"></i>Admin
                            </span>
                        }
                        else
                        {
                            <span class="badge-pi badge-muted">Kullanıcı</span>
                        }
                    </td>
                    <td style="padding:12px 22px;text-align:center;">@user.PlanCount</td>
                    <td style="padding:8px 22px;text-align:right;white-space:nowrap;">
                        <form asp-action="ToggleAdmin" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.UserId" />
                            <button type="submit" class="btn-pi btn-ghost-pi btn-sm-pi"
                                    title="@(user.IsAdmin ? "Admin yetkisini kaldır" : "Admin yap")">
                                <i class="bi @(user.IsAdmin ? "bi-shield-slash" : "bi-shield-check")"></i>
                            </button>
                        </form>
                        <form asp-action="DeleteUser" method="post" class="d-inline"
                              onsubmit="return confirm('@user.Email kullanıcısını ve tüm planlarını silmek istediğine emin misin?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.UserId" />
                            <button type="submit" class="btn-pi btn-ghost-pi btn-sm-pi" style="color:var(--danger);" title="Sil">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
