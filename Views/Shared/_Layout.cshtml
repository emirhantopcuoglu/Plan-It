<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Plan-It</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-check2"></i></span>
                    Plan-It
                </a>
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Menüyü aç">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @{
                        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
                        var action = ViewContext.RouteData.Values["action"]?.ToString();
                        var page = ViewContext.RouteData.Values["page"]?.ToString();
                        var isAuth = User.Identity?.IsAuthenticated ?? false;
                    }
                    <ul class="navbar-nav ms-auto">
                        @if (isAuth)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ctrl == "Plan" && action == "Index" ? "active" : "")"
                                   asp-controller="Plan" asp-action="Index">
                                    <i class="bi bi-kanban"></i>Pano
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ctrl == "Plan" && action == "Create" ? "active" : "")"
                                   asp-controller="Plan" asp-action="Create">
                                    <i class="bi bi-plus-lg"></i>Yeni Plan
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ctrl == "Admin" ? "active" : "")"
                                       asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-shield-lock"></i>Admin
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ctrl == "Category" ? "active" : "")"
                                       asp-controller="Category" asp-action="Index">
                                        <i class="bi bi-tags"></i>Kategoriler
                                    </a>
                                </li>
                            }
                            <li class="nav-divider d-none d-lg-block"></li>
                            <li class="nav-item">
                                @{
                                    var userName = User.Identity?.Name ?? "U";
                                    var initial = string.IsNullOrEmpty(userName) ? "U" : userName[..1].ToUpper();
                                }
                                <a class="nav-link user-pill" asp-area="Identity" asp-page="/Account/Logout"
                                   title="@userName">
                                    <span class="user-avatar">@initial</span>
                                    <span>Çıkış</span>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ctrl == "Home" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house"></i>Anasayfa
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(page?.Contains("Login") == true ? "active" : "")"
                                   asp-area="Identity" asp-page="/Account/Login">
                                    Giriş Yap
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-area="Identity" asp-page="/Account/Register"
                                   class="btn-pi btn-primary-pi btn-sm-pi ms-lg-2">
                                    Ücretsiz Başla
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        &copy; @DateTime.Now.Year Plan-It · Akıllı plan yönetimi
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
