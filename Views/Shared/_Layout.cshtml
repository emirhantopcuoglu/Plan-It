<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Plan-It</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-kanban">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-check2-circle"></i> Plan-It
                </a>
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center">
                        @{
                            var ctrl  = ViewContext.RouteData.Values["controller"]?.ToString();
                            var page  = ViewContext.RouteData.Values["page"]?.ToString();
                        }
                        <li class="nav-item">
                            <a class="nav-link @(ctrl == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i>Anasayfa
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ctrl == "Plan" ? "active" : "")"
                                   asp-controller="Plan" asp-action="Index">
                                    <i class="bi bi-kanban me-1"></i>Planlarım
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ctrl == "Plan" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")"
                                   asp-controller="Plan" asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i>Yeni Plan
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ctrl == "Category" ? "active" : "")"
                                       asp-controller="Category" asp-action="Index">
                                        <i class="bi bi-tags me-1"></i>Kategoriler
                                    </a>
                                </li>
                            }
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link nav-user" asp-area="Identity" asp-page="/Account/Logout">
                                    <span class="user-avatar">@(User.Identity!.Name?[0].ToString().ToUpper() ?? "U")</span>
                                    <span class="d-none d-lg-inline">Çıkış</span>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @(page?.Contains("Register") == true ? "active" : "")"
                                   asp-area="Identity" asp-page="/Account/Register">
                                    <i class="bi bi-person-plus me-1"></i>Kaydol
                                </a>
                            </li>
                            <li class="nav-item ms-lg-1">
                                <a class="nav-link nav-login-btn @(page?.Contains("Login") == true ? "active" : "")"
                                   asp-area="Identity" asp-page="/Account/Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Giriş Yap
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-kanban-content">
        @RenderBody()
    </div>

    <footer class="footer-kanban text-center py-3">
        <span>&copy; @DateTime.Now.Year Plan-It. Tüm hakları saklıdır.</span>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>
