@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="auth-shell">
    <div class="auth-card" style="text-align:center;">
        <div class="auth-head">
            <div class="auth-icon" style="background:var(--danger-soft);color:var(--danger);">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <h1>Bir şeyler ters gitti</h1>
            <p class="auth-sub">Üzgünüz, isteğin işlenirken bir hata oluştu.</p>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted-pi" style="font-size:0.82rem;">
                İstek No: <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn-pi btn-primary-pi">
            <i class="bi bi-house"></i>Anasayfaya Dön
        </a>
    </div>
</div>

<link href="~/css/auth.css" rel="stylesheet" asp-append-version="true" />
